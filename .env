################################################################################
# WEBSITE MONITOR - EMAIL CONFIGURATION
# Configure how email alerts are sent to users
################################################################################

# DEFAULT SMTP ACCOUNT (sends all alerts from this email)
SMTP_USER=pokurilahari16@gmail.com
SMTP_PASS=wpms rulq fgnv rfde
ALERT_FROM=pokurilahari16@gmail.com

# DEFAULT ALERT RECIPIENTS
# Option 1: Single email (default recipient for all sites)
ALERT_TO=pokurilahari16@gmail.com

# Option 2: Multiple emails (comma-separated, alerts to all these addresses)
# ALERT_TO=user1@gmail.com,user2@gmail.com,boss@company.com

################################################################################
# PER-USER SMTP CONFIGURATION (Optional)
# If enabled, each site can use different SMTP credentials
# This allows different users to send from their own Gmail accounts
################################################################################

# Enable per-site SMTP configuration (true/false)
# If true: Each site can have its own SMTP credentials in data/sites.json
# If false: Uses default SMTP account above for all sites
ENABLE_CUSTOM_SMTP=false

# EXAMPLE: Custom SMTP accounts can be configured in data/sites.json like:
# {
#   "id": "site-1",
#   "url": "https://example.com",
#   "alert_email": "recipient@gmail.com",
#   "smtp_user": "sender@gmail.com",      (optional - uses default if not set)
#   "smtp_pass": "app-password-here"      (optional - uses default if not set)
# }

################################################################################
# SMTP SERVER CONFIGURATION (for non-Gmail providers)
################################################################################

# Gmail: smtp.gmail.com
# Outlook: smtp.live.com
# Yahoo: smtp.mail.yahoo.com
# Custom: your-smtp-server.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

################################################################################
# ALERT SETTINGS
################################################################################

# Send email for major changes only (true) or major + minor (false)
MAJOR_ALERTS_ONLY=false

# Email subject line template
EMAIL_SUBJECT=🔔 Website Change Detected: {domain}

# Enable/disable email alerts globally
ALERTS_ENABLED=true