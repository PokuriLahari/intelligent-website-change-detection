################################################################################
# WEBSITE MONITOR - EMAIL CONFIGURATION
# Copy this file to .env and fill in your actual values
################################################################################

# DEFAULT SMTP ACCOUNT (sends all alerts from this email)
# Get your App Password from: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
ALERT_FROM=your-email@gmail.com

# DEFAULT ALERT RECIPIENTS
# Option 1: Single email (default recipient for all sites)
ALERT_TO=recipient@gmail.com

# Option 2: Multiple emails (comma-separated, alerts to all these addresses)
# ALERT_TO=alert1@gmail.com,alert2@gmail.com,boss@company.com

################################################################################
# ALERT PROVIDER — choose one: smtp | aws_ses | aws_sns | azure
# Default: smtp (Gmail / any SMTP server)
################################################################################

ALERT_PROVIDER=smtp

################################################################################
# AWS INTEGRATION (Free Tier)
#
# Option A — AWS SES (Simple Email Service)
#   Free tier: 62,000 emails/month when sent from Amazon EC2/Lambda
#   Outside EC2: first 62,000 emails/month free (sandbox), then $0.10/1000
#   Setup: https://docs.aws.amazon.com/ses/latest/dg/setting-up.html
#
# Option B — AWS SNS (Simple Notification Service)
#   Free tier: 1,000,000 notifications/month — ALWAYS FREE
#   Setup: https://docs.aws.amazon.com/sns/latest/dg/sns-getting-started.html
#
# Steps to enable:
#   1. Create an AWS Free account at https://aws.amazon.com/free/
#   2. Create an IAM user with AmazonSESFullAccess or AmazonSNSFullAccess
#   3. Generate Access Key & Secret Key for that IAM user
#   4. For SES: verify your sender email address in the AWS SES console
#   5. For SNS: create a Topic (Standard) and copy its ARN
#   6. Set ALERT_PROVIDER=aws_ses  OR  ALERT_PROVIDER=aws_sns below
################################################################################

AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY_HERE
AWS_REGION=us-east-1

# For AWS SNS only — paste the ARN from the SNS console
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:website-monitor-alerts

################################################################################
# AZURE INTEGRATION (Free Tier)
#
# Azure Communication Services — Email
#   Free tier: 100 emails/day on Azure Free account
#   Setup: https://learn.microsoft.com/en-us/azure/communication-services/quickstarts/email/send-email
#
# Steps to enable:
#   1. Create a free Azure account at https://azure.microsoft.com/free/
#   2. Create an Azure Communication Services resource
#   3. Add a free Email Communication Services resource and verify a domain
#   4. Copy the connection string from the Azure portal
#   5. Set ALERT_PROVIDER=azure and ALERT_FROM to your verified sender address
#   6. Set ALERT_TO to your recipient email address
################################################################################

AZURE_COMMUNICATION_CONNECTION_STRING=YOUR_AZURE_CONNECTION_STRING_HERE

################################################################################
# PER-USER SMTP CONFIGURATION (Optional)
# If enabled, each site can use different SMTP credentials
# This allows different users/teams to send from their own Gmail accounts
################################################################################

# Enable per-site SMTP configuration (true/false)
# Default: false (uses SMTP account above for all sites)
ENABLE_CUSTOM_SMTP=false

# EXAMPLE: To use custom SMTP per-site, set ENABLE_CUSTOM_SMTP=true
# Then configure sites in data/sites.json with extra fields:
# {
#   "id": "site-1",
#   "url": "https://example.com",
#   "alert_email": "my-email@gmail.com",           (required)
#   "smtp_user": "my-smtp@gmail.com",              (optional - uses default if missing)
#   "smtp_pass": "xxxx xxxx xxxx xxxx"             (optional - uses default if missing)
# }

################################################################################
# SMTP SERVER CONFIGURATION (for non-Gmail providers)
################################################################################

# Gmail: smtp.gmail.com
# Outlook/Hotmail: smtp.live.com
# Yahoo Mail: smtp.mail.yahoo.com
# Custom: your-smtp-server.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

################################################################################
# ALERT SETTINGS
################################################################################

# Send email for major changes only (true) or major + minor (false)
MAJOR_ALERTS_ONLY=false

# Email subject line template
EMAIL_SUBJECT=🔔 Website Change Detected: {domain}

# Enable/disable email alerts globally (true/false)
ALERTS_ENABLED=true
