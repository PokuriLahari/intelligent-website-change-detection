################################################################################
# WEBSITE MONITOR - EMAIL CONFIGURATION
# Copy this file to .env and fill in your actual values
################################################################################

# DEFAULT SMTP ACCOUNT (sends all alerts from this email)
# Get your App Password from: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
ALERT_FROM=your-email@gmail.com

# DEFAULT ALERT RECIPIENTS
# Option 1: Single email (default recipient for all sites)
ALERT_TO=recipient@gmail.com

# Option 2: Multiple emails (comma-separated, alerts to all these addresses)
# ALERT_TO=alert1@gmail.com,alert2@gmail.com,boss@company.com

################################################################################
# PER-USER SMTP CONFIGURATION (Optional)
# If enabled, each site can use different SMTP credentials
# This allows different users/teams to send from their own Gmail accounts
################################################################################

# Enable per-site SMTP configuration (true/false)
# Default: false (uses SMTP account above for all sites)
ENABLE_CUSTOM_SMTP=false

# EXAMPLE: To use custom SMTP per-site, set ENABLE_CUSTOM_SMTP=true
# Then configure sites in data/sites.json with extra fields:
# {
#   "id": "site-1",
#   "url": "https://example.com",
#   "alert_email": "my-email@gmail.com",           (required)
#   "smtp_user": "my-smtp@gmail.com",              (optional - uses default if missing)
#   "smtp_pass": "xxxx xxxx xxxx xxxx"             (optional - uses default if missing)
# }

################################################################################
# SMTP SERVER CONFIGURATION (for non-Gmail providers)
################################################################################

# Gmail: smtp.gmail.com
# Outlook/Hotmail: smtp.live.com
# Yahoo Mail: smtp.mail.yahoo.com
# Custom: your-smtp-server.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

################################################################################
# ALERT SETTINGS
################################################################################

# Send email for major changes only (true) or major + minor (false)
MAJOR_ALERTS_ONLY=false

# Email subject line template
EMAIL_SUBJECT=🔔 Website Change Detected: {domain}

# Enable/disable email alerts globally (true/false)
ALERTS_ENABLED=true

################################################################################
# AWS CLOUD INTEGRATION (Free Tier)
# ─────────────────────────────────
# Create a free AWS account at https://aws.amazon.com/free/
# Required IAM permissions: sns:Publish, ses:SendEmail
################################################################################

# AWS credentials (create an IAM user with limited permissions)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# ── AWS SNS (Simple Notification Service) ────────────────────────────────────
# Free tier: 1,000 email notifications + 1,000 HTTP/HTTPS deliveries per month
# Steps:
#   1. Go to AWS Console → SNS → Topics → Create topic (Standard)
#   2. Copy the Topic ARN here
#   3. Create an email subscription and confirm it via the email link
# Docs: https://docs.aws.amazon.com/sns/latest/dg/welcome.html
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:website-monitor-alerts

# ── AWS SES (Simple Email Service) ───────────────────────────────────────────
# Free tier: 200 emails/day (sandbox); 62,000 emails/month when sent from EC2
# Steps:
#   1. Go to AWS Console → SES → Verified identities → Verify your email address
#   2. Set AWS_SES_SENDER_EMAIL to the verified address
#   3. In sandbox mode, the ALERT_TO address must also be verified
# Docs: https://docs.aws.amazon.com/ses/latest/dg/Welcome.html
AWS_SES_SENDER_EMAIL=your-verified@example.com

################################################################################
# AZURE CLOUD INTEGRATION (Free Tier)
# ─────────────────────────────────────
# Create a free Azure account at https://azure.microsoft.com/en-us/free/
# Azure Communication Services Email: 100 emails/day — always free
################################################################################

# ── Azure Communication Services (ACS) Email ─────────────────────────────────
# Free tier: 100 emails/day, no credit card required for this limit
# Steps:
#   1. Create an Azure Communication Services resource in the Azure portal
#   2. Add an Email Communication Service and link it to your ACS resource
#   3. Add a verified sender domain (or use the free Azure-managed domain)
#   4. Copy the connection string from ACS → Keys → Connection string
# Docs: https://learn.microsoft.com/en-us/azure/communication-services/quickstarts/email/send-email
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://your-acs.communication.azure.com/;accesskey=your-key
AZURE_ACS_SENDER_ADDRESS=DoNotReply@your-domain.azurecomm.net
